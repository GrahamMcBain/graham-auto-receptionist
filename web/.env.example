# Public LiveKit endpoint used by the browser once the API returns a room token.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# The dashboard proxy uses this local service during development.
TOKEN_API_PORT=3001
LIVEKIT_AGENT_NAME=graham-auto-receptionist-agent

# Keep these on the server only (for the API token endpoint and agent worker).
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
OPENAI_API_KEY=your_openai_key
