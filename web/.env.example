# Public LiveKit endpoint used by the browser once the API returns a room token.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# The dashboard proxy uses this local service during development.
TOKEN_API_PORT=3001
LIVEKIT_AGENT_NAME=graham-auto-receptionist-agent

# Keep these on the server only (for the API token endpoint and agent worker).
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
OPENAI_API_KEY=your_openai_key

# Temporal Cloud — used only by Vercel API routes, never by browser code.
TEMPORAL_ADDRESS=your-namespace.account.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.account
TEMPORAL_API_KEY=replace-with-a-temporal-cloud-api-key
TEMPORAL_TASK_QUEUE=auto-receptionist
# Shared only with the LiveKit agent for server-to-server booking calls.
TEMPORAL_BOOKING_API_SECRET=replace-with-a-long-random-secret
